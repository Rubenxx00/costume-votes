# Costume Votes — environment for systemd
# Install to /etc/costume-votes.env, then: sudo chmod 600 /etc/costume-votes.env
#
#   sudo install -m 600 deploy/costume-votes.env.example /etc/costume-votes.env
#   sudo editor /etc/costume-votes.env

# Generated once:  openssl rand -base64 24
# Change it in the admin console before the party if you like — this value is
# only used to create the account on first boot.
ADMIN_PASSWORD=change-me-before-first-boot

PORT=3000
DATA_DIR=/opt/costume-votes/data

# Shown at boot so you know which URL to hand to guests.
PUBLIC_BASE_URL=https://costume-votes.example.com

# --- Optional -------------------------------------------------------------

# Signs the admin session cookie. Unset is fine and normal: the app sets the
# `Secure` flag per request instead, so both the https:// tunnel URL and a
# plain http://<vm-ip>:3000 login work. Set only if you want to force Secure.
# ADMIN_SECRET=

# Force the flag regardless of scheme (only if something in front rewrites the
# protocol headers).
# FORCE_SECURE_COOKIE=1

# --- Notes ----------------------------------------------------------------
#
# You do not need to restrict the bind address: leave the Oracle security list
# closed for every inbound port. cloudflared dials out to Cloudflare, so no
# inbound rule is required and the app is unreachable by IP.
#
# cloudflared runs as its OWN service, separate from this one:
#
#   sudo systemctl status cloudflared
#   sudo journalctl -u cloudflared -n 50
#
# If the tunnel is down the app still runs; it is just unreachable from
# outside. Restart the two independently.