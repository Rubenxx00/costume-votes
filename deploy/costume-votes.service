[Unit]
Description=Costume Votes
Documentation=https://github.com/Rubenxx00/costume-votes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# A dedicated system account, created by deploy/install.sh. Do NOT set this to a
# login user (the file used to say `ubuntu`, which exists only on Ubuntu images):
# on any host without that account systemd fails the unit with status=217/USER
# before the app is even executed.
User=costume-votes
Group=costume-votes
WorkingDirectory=/opt/costume-votes

# The admin password is generated once and stored here (chmod 600).
# ADMIN_SECRET signs the session cookie; leave it unset and the app decides
# `Secure` per request, which is what lets you also use http://<vm-ip>:3000.
EnvironmentFile=/etc/costume-votes.env

# Absolute path on purpose: systemd does not run a login shell, so a Node that
# lives on PATH via nvm/asdf will not be found. Adjust if `command -v node` on
# the host disagrees.
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3

# Node needs no more privileges than this.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK is required, not optional: os.networkInterfaces() goes through
# getifaddrs(), which is a netlink socket. Without it Node throws
# `uv_interface_addresses returned Unknown system error 97` (EAFNOSUPPORT) and
# dies on startup — the app never binds and the unit restart-loops.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The only writable path: the database and uploaded photos.
ReadWritePaths=/opt/costume-votes/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=costume-votes

[Install]
WantedBy=multi-user.target